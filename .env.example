# =============================================================================
# Prière & Coran — Variables d'environnement
# Copier ce fichier :  cp .env.example .env
# NE JAMAIS committer le fichier .env réel.
# =============================================================================

# --- Django ------------------------------------------------------------------
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-random-50-chars-key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- CORS / Frontend ---------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=prayer_coran
POSTGRES_USER=prayer
POSTGRES_PASSWORD=prayer_dev_password
DB_HOST=db
# Port utilisé par les conteneurs backend/worker/beat pour joindre le service
# "db" DANS le réseau Docker (ne pas confondre avec le port hôte du debug,
# mappé à 127.0.0.1:25432 dans docker-compose.yml).
DB_PORT=5432

# --- Redis (cache Django / broker & résultats Celery) ------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- API Aladhan (horaires de prière) ----------------------------------------
# API publique, sans clé requise. La base est configurable pour les tests.
ALADHAN_API_BASE_URL=https://api.aladhan.com/v1

# --- Quran Foundation API v4 (Coran, texte, audio, traductions) --------------
# Créer un compte sur https://quran.foundation et demander un accès API.
# Ces identifiants restent STRICTEMENT côté serveur (jamais exposés au frontend).
QURAN_API_BASE_URL=https://api.quran.com/api/v4
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

# --- Web Push (VAPID) --------------------------------------------------------
# Générer une paire de clés : npx web-push generate-vapid-keys
# La clé PUBLIQUE est servie par l'API au frontend ; la clé privée reste serveur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# --- Frontend (Vite, préfixe VITE_) ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
# La clé publique VAPID est aussi récupérable via /api/v1/notifications/vapid-key/,
# mais la fournir à Vite simplifie le service worker.
VITE_VAPID_PUBLIC_KEY=

# --- Récitateurs hébergés localement (MP3 dans frontend/public/quran/) --------
# false = masqués (déploiement sans l'audio de Benmoussa, 816 Mo).
LOCAL_RECITERS_ENABLED=true

# --- Fuseau horaire des conteneurs -------------------------------------------
TZ=Europe/Paris

# --- Docker (développement) -------------------------------------------------
# Aligner l'UID/GID du conteneur sur l'utilisateur hôte : évite les problèmes
# de permissions sur les volumes montés (./backend). Trouver vos valeurs : `id`
DOCKER_UID=1000
DOCKER_GID=1001
